{
  "name": "cs396-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "check": "npm run lint && npm run typecheck",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-facilities-from-csv.ts",
    "dev": "next dev --webpack",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,md}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "next start",
    "sync:campd": "tsx scripts/sync_campd.ts",
    "test": "node --import tsx --test src/lib/domain-utils.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run check && npm test && npm run build"
  },
  "dependencies": {
