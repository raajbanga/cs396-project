# Copy to `.env` and fill in. Never commit real secrets; keep this file in sync with `src/env.js`.

# Drizzle / LibSQL
DATABASE_URL="file:./db.sqlite"
DATABASE_AUTH_TOKEN=""

# EPA CAMPD API Key (https://www.epa.gov/airmarkets/cam-api-portal)
CAMPD_API="your-epa-campd-api-key-here"

# CARTO basemap key (https://carto.com/) — optional; the flat map uses light or dark tiles to match the theme, and public dark tiles without it
NEXT_PUBLIC_CARTO_API=""

# OpenRouter (https://openrouter.ai/keys) — optional; description search falls back to the rule-based parser alone when unset
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
