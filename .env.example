# Copy to `.env` and fill in. Never commit real secrets; keep this file in sync with `src/env.js`.

# Drizzle / LibSQL
DATABASE_URL="file:./db.sqlite"
DATABASE_AUTH_TOKEN=""

# EPA CAMPD API Key (https://www.epa.gov/airmarkets/cam-api-portal)
CAMPD_API="your-epa-campd-api-key-here"

# CARTO Basemap API Key (https://carto.com/) — optional; the 2D map falls back to public dark tiles
NEXT_PUBLIC_CARTO_API=""
